{{/*
  guide.pdf.tmpl — Compo 写作指引 A4 打印模板 (Go html/template).

  Schema: guide.v1
  Renderer: pkg/artifact.HTMLRenderer (auto-injects @media print CSS — do NOT
  duplicate the print stylesheet here).

  Structural delta vs guide.html.tmpl:
    - @page A4 with 18mm margin
    - Slightly larger body font (15→16px display, 17px sample) for print legibility
    - Family signature row + tutoring date row pinned to page bottom
*/}}<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>{{ .Title }} · Compo 写作指引（打印版）</title>
  <style>
    @page {
      size: A4;
      margin: 18mm;
    }

    :root {
      --soy-milk:      #FBFAF5;
      --tofu:          #FFFFFF;
      --soy-sauce:     #2B2419;
      --soybean-gold:  #E0A52C;
      --soybean-skin:  #FBEFCF;
      --roasted-soy:   #A6781C;
      --edamame:       #7BA23F;
      --warm-700:      #4A4133;
      --warm-600:      #6B6051;
      --warm-500:      #8C8170;
      --warm-300:      #D4CBB5;
      --warm-200:      #E7E0CC;
      --warm-100:      #F1ECDC;
      --warm-50:       #F8F5EC;
      --border-subtle: rgba(75,65,51,0.10);
      --border-medium: rgba(75,65,51,0.16);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      background: var(--soy-milk);
      color: var(--soy-sauce);
      font-family: "Plus Jakarta Sans", "PingFang SC", "HarmonyOS Sans SC",
                   system-ui, -apple-system, sans-serif;
      font-size: 15px;
      line-height: 1.65;
    }

    .sheet {
      width: 100%;
    }

    .eyebrow {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      color: var(--roasted-soy);
      margin-bottom: 8px;
    }

    h1.title {
      font-size: 30px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.4px;
      margin: 0 0 20px;
    }

    .opening {
      background: var(--tofu);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 14px 18px;
      margin-bottom: 18px;
    }
    .opening h2 {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      color: var(--roasted-soy);
      margin: 0 0 6px;
    }
    .opening p {
      margin: 0;
      font-size: 15px;
      line-height: 1.65;
      color: var(--warm-700);
    }

    .section-label {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      color: var(--roasted-soy);
      margin: 0 0 10px;
    }

    /* 家长可执行的体验式辅导路线 ------------------------------------- */
    .coach-card, .voice-note {
      background: var(--tofu);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 14px 18px;
      margin-bottom: 14px;
      break-inside: avoid;
    }
    .coach-card h2, .voice-note h2 {
      font-size: 15px;
      margin: 0 0 7px;
    }
    .scene { margin: 0 0 7px; color: var(--warm-700); }
    .materials { margin-bottom: 8px; }
    .material {
      display: inline-block;
      background: var(--soybean-skin);
      border-radius: 9999px;
      padding: 2px 8px;
      margin-right: 5px;
      font-size: 11.5px;
    }
    .action-list, .organize-list { margin: 0; padding-left: 20px; }
    .action-list li, .organize-list li { margin: 5px 0; }
    .parent-prompt { display: block; color: var(--roasted-soy); font-weight: 600; }
    .questions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-bottom: 14px;
    }
    .question {
      background: var(--warm-50);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      padding: 9px 11px;
      break-inside: avoid;
    }
    .question .focus { color: var(--roasted-soy); font-size: 10.5px; font-weight: 700; }
    .question p { margin: 3px 0 0; font-size: 12px; line-height: 1.5; }
    .question .follow-up { color: var(--warm-600); }
    .voice-note { background: var(--soybean-skin); }
    .voice-note > p { margin: 6px 0; }
    .privacy { color: var(--adzuki); font-size: 11.5px; }

    /* Three writing-point cards: 3-col print grid ----------------------- */
    .points {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
      margin-bottom: 18px;
      counter-reset: point;
    }
    .point.card {
      background: var(--tofu);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 14px;
      position: relative;
      break-inside: avoid;
      counter-increment: point;
    }
    .point.card::after {
      content: counter(point, decimal-leading-zero);
      position: absolute;
      top: 10px;
      right: 12px;
      font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.4px;
      color: var(--soybean-gold);
    }
    .point h3 {
      font-size: 16px;
      font-weight: 600;
      line-height: 1.35;
      letter-spacing: -0.2px;
      margin: 0 0 8px;
    }
    .point p {
      margin: 0;
      font-size: 13.5px;
      line-height: 1.55;
      color: var(--warm-600);
    }

    /* Two-column 好词 / 好句 ------------------------------------------- */
    .vocab-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 18px;
    }
    .vocab-col.card {
      background: var(--tofu);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 14px 18px;
      break-inside: avoid;
    }
    .vocab-col h2 {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      color: var(--roasted-soy);
      margin: 0 0 10px;
    }
    .vocab-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .vocab-list li {
      padding: 5px 0;
      border-bottom: 1px solid var(--border-subtle);
      font-size: 13.5px;
      line-height: 1.55;
      color: var(--warm-700);
    }
    .vocab-list li:last-child { border-bottom: none; }
    .vocab-list .word {
      font-weight: 600;
      color: var(--soy-sauce);
      margin-right: 6px;
    }
    .vocab-list .meaning,
    .vocab-list .why {
      color: var(--warm-600);
      font-size: 12.5px;
    }
    .vocab-list .phrase {
      display: block;
      color: var(--soy-sauce);
      margin-bottom: 2px;
    }

    /* 避坑提示 --------------------------------------------------------- */
    .pitfalls {
      background: var(--soybean-skin);
      border: 1px solid var(--border-medium);
      border-radius: 14px;
      padding: 14px 18px;
      margin-bottom: 18px;
    }
    .pitfalls h2 {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      color: var(--roasted-soy);
      margin: 0 0 10px;
    }
    .pitfalls ol {
      margin: 0;
      padding-left: 0;
      counter-reset: pitfall;
      list-style: none;
    }
    .pitfalls li {
      counter-increment: pitfall;
      padding: 6px 0 6px 28px;
      border-bottom: 1px solid var(--border-subtle);
      font-size: 13.5px;
      line-height: 1.55;
      color: var(--warm-700);
      position: relative;
    }
    .pitfalls li:last-child { border-bottom: none; }
    .pitfalls li::before {
      content: counter(pitfall);
      position: absolute;
      left: 0;
      top: 6px;
      width: 20px;
      height: 20px;
      border-radius: 9999px;
      background: var(--soybean-gold);
      color: var(--soy-sauce);
      font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .pitfalls .pitfall-title {
      font-weight: 600;
      color: var(--soy-sauce);
      margin-right: 6px;
    }

    /* 范例段落 — 打印版字体略大，便于辅导朗读 */
    .sample.card {
      background: var(--tofu);
      border: 1px solid var(--border-subtle);
      border-left: 3px solid var(--soybean-gold);
      border-radius: 14px;
      padding: 14px 18px;
      margin-bottom: 24px;
      break-inside: avoid;
    }
    .sample h2 {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      color: var(--roasted-soy);
      margin: 0 0 8px;
    }
    .sample p {
      margin: 0;
      font-size: 16px;
      line-height: 1.85;
      color: var(--warm-700);
      text-indent: 2em;
    }

    /* 家长签名 + 辅导日期 — 页脚 -------------------------------------- */
    .signoff {
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px dashed var(--border-medium);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      break-inside: avoid;
    }
    .signoff .row {
      display: flex;
      align-items: flex-end;
      gap: 8px;
      font-size: 13px;
      color: var(--warm-600);
    }
    .signoff .row .label {
      font-weight: 600;
      color: var(--soy-sauce);
      white-space: nowrap;
    }
    .signoff .row .line {
      flex: 1;
      border-bottom: 1px solid var(--soy-sauce);
      min-height: 22px;
    }

    .footer-note {
      margin-top: 14px;
      font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 10px;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      color: var(--warm-500);
      text-align: center;
    }
  </style>
</head>
<body>
  <section class="sheet">
    <div class="eyebrow">Compo · 小学作文写作指引（打印版）</div>
    <h1 class="title">{{ .Title }}</h1>

    <section class="coach-card">
      <h2>先体验，再写作</h2>
      <p class="scene">{{ .ExperiencePlan.RecommendedScene }}</p>
      <div class="materials">
        {{ range .ExperiencePlan.Materials }}<span class="material">{{ . }}</span>{{ end }}
      </div>
      <ol class="action-list">
        {{ range .ExperiencePlan.Steps }}
        <li>{{ .Action }}<span class="parent-prompt">家长这样问：{{ .ParentPrompt }}</span></li>
        {{ end }}
      </ol>
    </section>

    <h2 class="section-label">六个对话问题 · 不给标准答案</h2>
    <section class="questions">
      <article class="question"><span class="focus">看</span><p>观察《{{ .Title }}》时，你看到了哪些颜色、形状或动作？</p><p class="follow-up">继续追问：哪个具体细节让你这样想？</p></article>
      <article class="question"><span class="focus">闻</span><p>现场有哪些气味？它们怎样发生变化？</p><p class="follow-up">继续追问：哪一个时刻闻得最清楚？</p></article>
      <article class="question"><span class="focus">摸 · 温度</span><p>在确保安全的前提下，你感受到哪些触感或温度？</p><p class="follow-up">继续追问：这种感觉后来怎样变化？</p></article>
      <article class="question"><span class="focus">听</span><p>安静十秒，你听到了哪些远近不同的声音？</p><p class="follow-up">继续追问：哪个声音最能代表当时的现场？</p></article>
      <article class="question"><span class="focus">联想</span><p>这些真实观察让你想到了什么？为什么？</p><p class="follow-up">继续追问：哪个细节支持你的想法？</p></article>
      <article class="question"><span class="focus">感受 · 变化</span><p>体验前后，你的想法或心情发生了什么变化？</p><p class="follow-up">继续追问：哪一刻让变化真正发生？</p></article>
    </section>

    <section class="voice-note">
      <h2>把孩子的口述变成写作素材</h2>
      <p>{{ .VoiceCapture.Instruction }}</p>
      <ol class="organize-list">
        {{ range .VoiceCapture.OrganizeSteps }}<li>{{ . }}</li>{{ end }}
      </ol>
      <p class="privacy">隐私提醒：{{ .VoiceCapture.PrivacyNote }}</p>
    </section>

    <section class="opening">
      <h2>开篇方向</h2>
      <p>{{ .OpeningDirection }}</p>
    </section>

    <h2 class="section-label">三个写作要点</h2>
    <section class="points">
      {{ range .WritingPoints }}
      <article class="point card">
        <h3>{{ .TitleZH }}</h3>
        <p>{{ .BodyZH }}</p>
      </article>
      {{ end }}
    </section>

    <div class="vocab-grid">
      <section class="vocab-col card">
        <h2>好词 · 8 个</h2>
        <ul class="vocab-list">
          {{ range .Vocabulary }}
          <li><span class="word">{{ .Word }}</span><span class="meaning">{{ .MeaningZH }}</span></li>
          {{ end }}
        </ul>
      </section>
      <section class="vocab-col card">
        <h2>好句 · 5 句</h2>
        <ul class="vocab-list">
          {{ range .GoodPhrases }}
          <li><span class="phrase">{{ .Phrase }}</span><span class="why">{{ .WhyZH }}</span></li>
          {{ end }}
        </ul>
      </section>
    </div>

    <section class="pitfalls">
      <h2>要避免的 3 个坑</h2>
      <ol>
        {{ range .Pitfalls }}
        <li><span class="pitfall-title">{{ .TitleZH }}</span>{{ .FixZH }}</li>
        {{ end }}
      </ol>
    </section>

    <section class="sample card">
      <h2>范例段落 · 仅供模仿，不要照抄</h2>
      <p>{{ .SampleParagraph }}</p>
    </section>

    <section class="signoff">
      <div class="row">
        <span class="label">家长签名</span>
        <span class="line"></span>
      </div>
      <div class="row">
        <span class="label">辅导日期</span>
        <span class="line"></span>
      </div>
    </section>

    <div class="footer-note">Generated by Compo · SoyaPack v0 · guide.v1</div>
  </section>
</body>
</html>
