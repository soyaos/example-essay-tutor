# Build / release artifacts (SoyaPack archives, rendered guides)
/dist/
/artifacts/
*.tar.zst
*.pdf
*.png.tmp

# …except the committed font-rendering evidence (APP-1058): the E2E suite
# regenerates these, and they are part of the repo's acceptance record.
!/examples/rendered/*.pdf

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Python / shell tooling we sometimes shell out to
__pycache__/
*.pyc
venv/
.venv/

# Local secrets (never commit)
.env
.env.*
!.env.example

# Local renderer scratch
/.scratch/
